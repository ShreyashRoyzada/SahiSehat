# Copy to .env.local for development. Everything is optional in development.

# Where SQLite databases live (catalogue/app store and the separate health vault).
DATA_DIR=./.data

# 32 random bytes, base64. REQUIRED in production: encrypts every health value in the vault.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=

# Admin console: shared password + TOTP secret (base32) for two-factor. Both REQUIRED in production.
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Comma-separated invite codes for the invite-only beta (seeded on first start).
INVITE_CODES=SAHI-BETA-2026

# preview = show draft products with "seed estimate" labelling (default)
# beta    = show only products published through the admin console (A1 checks)
CATALOGUE_MODE=preview

# Optional. With a key, report extraction and the assistant use Claude (claude-opus-5-5);
# without one they use the built-in rule-based reader and responder. Verdicts never come from the model.
ANTHROPIC_API_KEY=

# Optional: pin "today" (staleness, marker age) for demos and tests, e.g. 2026-10-02
SAHI_AS_OF=
